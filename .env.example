# =============================================================================
# PRODUCTION REQUIRED (set these on Vercel / host before going live)
# =============================================================================
# NEXTAUTH_SECRET=          # long random string (openssl rand -base64 32)
# NEXTAUTH_URL=https://YOUR_DOMAIN
# NEXT_PUBLIC_SITE_URL=https://YOUR_DOMAIN
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# ADMIN_PIN=                # unique 6-digit PIN — NOT the example 501499
# CRON_SECRET=              # required in production (Vercel Cron Authorization bearer)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# RESEND_API_KEY=           # required to email payment receipts + plan PDF attachments
# EMAIL_FROM=Planasia <noreply@planasia.net>  # must use a Resend-verified domain
# SLIPMATE_API_KEY=         # required for auto-verify — SlipMate Open API key (server-only, never commit)
#                            # Without it, slip uploads still succeed and queue for manual admin review.
#
# Payments: bank transfer + SlipMate slip verification (Stripe removed).
# Configure bank account + QR in Admin → การตั้งค่าการชำระเงิน
# Set SLIPMATE_API_KEY in .env.local / Vercel → Settings → Environment Variables (Production), then Redeploy.

# NEVER set ALLOW_MOCK_PAYMENTS in production (ignored even if set).
# Vendor APIs require Google session in production (set VENDOR_REQUIRE_SESSION=false only for local).
#
# Bootstrap: missing required keys WARN on Vercel production but do not fail the build.
# After all secrets are filled, set STRICT_PRODUCTION_ENV=1 to hard-fail incomplete deploys.
# STRICT_PRODUCTION_ENV=1

# =============================================================================
# Local / shared configuration
# =============================================================================

# Google OAuth (NextAuth) — optional for buyers; admin uses PIN
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Required in production (Vercel). AUTH_SECRET is accepted as an alias.
NEXTAUTH_SECRET=
# AUTH_SECRET=

# Gemini AI (Google AI Studio — https://aistudio.google.com/apikey)
# Enables: text/image models, dynamic translation capability, unit-assist hooks
# Status probe: GET /api/gemini/status
GEMINI_API_KEY=
# Optional master switch (default: on when GEMINI_API_KEY is set)
# GEMINI_ENABLED=true
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Google Cloud Translation API (optional fallback for /api/gemini/translate strings)
GOOGLE_TRANSLATE_API_KEY=

# Document / OCR translation (disabled while THAI_DOMESTIC_MARKET=true)
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_CLOUD_PROJECT=
# TRANSLATE_LOCATION=us-central1
# GOOGLE_DOCUMENT_TRANSLATION_ENABLED=false
# GOOGLE_VISION_OCR_ENABLED=false
# GOOGLE_VISION_API_KEY=


# Bank transfer + SlipMate automatic slip verification (Stripe removed)
# Configure bank account + QR in Admin → การตั้งค่าการชำระเงิน
# Required for auto-verify (server-only — never commit the real key):
# SLIPMATE_API_KEY=
# Optional:
# SLIPMATE_API_BASE_URL=https://api.slipmate.ai/open-api
# SLIPMATE_ALLOW_DUPLICATE=false
# SLIPMATE_MATCH_AMOUNT=true
# Ops check: GET /api/payments/status
# Dev only — permanently disabled when NODE_ENV or VERCEL_ENV is production.
# ALLOW_MOCK_PAYMENTS=true

# IP Geolocation (optional)
IPAPI_KEY=

# Public site URL for SEO
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin PIN (6 digits) — change before production; default 501499 is rejected by env check
ADMIN_PIN=501499
ADMIN_EMAILS=

# Vercel Cron /api/cron/ranking
CRON_SECRET=

# Force Google session for vendor APIs even in development
# VENDOR_REQUIRE_SESSION=true

# Local emergency email login — OFF. Ignored in production.
# ADMIN_DEV_LOGIN=true
# ADMIN_DEV_ALLOW_ANY=true

# Web Push (optional)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Buyer payment receipt + house-plan PDF attachments (Resend)
# Sent automatically after successful Stripe/cart payment via finalizePaidCartSale.
# Also used for designer sale-alert emails (fallback when SMS is unavailable).
RESEND_API_KEY=
EMAIL_FROM=Planasia <noreply@planasia.net>

# Designer post-sale SMS — triggered when Stripe payment webhook confirms Paid.
# Mapping: listing → store_listings.owner_id → vendor_profiles.contact_phone
#
# Preferred: ThaiBulkSMS API v2
# THAIBULKSMS_API_KEY=
# THAIBULKSMS_API_SECRET=
# Aliases also accepted:
# THAI_BULK_SMS_API_KEY=
# THAI_BULK_SMS_API_SECRET=
# Optional approved Sender Name only (omit to use account default — "SMS" often 400s)
# THAIBULKSMS_SENDER=
# THAIBULKSMS_FORCE=corporate
# If standard credits are depleted, the sender auto-retries corporate/premium.
# Optional webhook auth for delivery callbacks:
# THAIBULKSMS_WEBHOOK_SECRET=
# Webhook URL to paste in ThaiBulkSMS console:
#   https://planasia.net/api/webhooks/sms-seller
#   (or with secret) https://planasia.net/api/webhooks/sms-seller?token=YOUR_SECRET
#
# Fallback: Twilio (used only when ThaiBulkSMS is not configured)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+66xxxxxxxxx
# TWILIO_MESSAGING_SERVICE_SID=

# LINE Messaging API
# Webhook URL (paste in LINE Developers console):
#   https://planasia.net/api/webhooks/line
# LINE_CHANNEL_ID=
# LINE_CHANNEL_SECRET=
# LINE_CHANNEL_ACCESS_TOKEN=
